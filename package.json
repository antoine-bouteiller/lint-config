{
  "name": "@antoine-bouteiller/lint-config",
  "version": "0.0.0-semantic-release",
  "description": "Shared Oxlint config and custom rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoine-bouteiller/lint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.json": "./dist/base.json",
    "./plugin": "./dist/plugin/index.js",
    "./react.json": "./dist/react.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/write-json-configs.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm build && oxlint --deny-warnings --report-unused-disable-directives",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@oxlint/plugins": "1.89.0",
    "@semantic-release/exec": "7.1.0",
    "@types/node": "26.6.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "26.0.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.89.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
